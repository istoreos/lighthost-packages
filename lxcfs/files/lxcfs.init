#!/bin/sh /etc/rc.common

START=19
STOP=81
USE_PROCD=1

start_service() {
	mkdir -p /var/lib/lxcfs

	procd_open_instance
	procd_set_param command /usr/bin/lxcfs -f -p /var/run/lxcfs.pid /var/lib/lxcfs
	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger lxcfs
}
