From: LightHost <support@linkease.com>
Subject: [PATCH] build: render simple templates without Jinja2

LXCFS 6.0 templates only use direct {{VARIABLE}} substitutions. Keep strict
undefined-variable handling while avoiding a large host Jinja2 dependency on
embedded OpenWrt build systems.

--- a/meson.build
+++ b/meson.build
@@ -17,13 +17,6 @@ project(
 
 cc = meson.get_compiler('c')
 
-# Templater.
-if run_command(
-    'python3', '-c', 'import jinja2',
-    check: false).returncode() != 0
-        error('python3 jinja2 missing')
-endif
-
 meson_build_sh = find_program('tools/meson-build.sh')
 meson_render_jinja2 = find_program('tools/meson-render-jinja2.py')
 
--- a/tools/meson-render-jinja2.py
+++ b/tools/meson-render-jinja2.py
@@ -6,8 +6,6 @@ import os
 import re
 import sys
 
-import jinja2
-
 def parse_config_h(filename):
     # Parse config.h file generated by meson.
     ans = {}
@@ -23,12 +21,14 @@ def parse_config_h(filename):
 
 def render(filename, defines):
     text = open(filename).read()
-    template = jinja2.Template(
-        text,
-        trim_blocks=True,
-        keep_trailing_newline=True,
-        undefined=jinja2.StrictUndefined,
-    )
-    return template.render(defines)
+    pattern = re.compile(r'{{\s*([A-Za-z_][A-Za-z0-9_]*)\s*}}')
+
+    def substitute(match):
+        name = match.group(1)
+        if name not in defines:
+            raise KeyError('undefined template variable: ' + name)
+        return str(defines[name])
+
+    return pattern.sub(substitute, text)
 
 if __name__ == '__main__':
     defines = parse_config_h(sys.argv[1])
