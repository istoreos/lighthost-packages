#!/bin/sh

set -eu
umask 077

output="${1:-/tmp/lighthost-diagnostics-$(date -u +%Y%m%dT%H%M%SZ).tar.gz}"
case "$output" in
	/*) ;;
	*) echo 'output path must be absolute' >&2; exit 2 ;;
esac

work="$(mktemp -d /tmp/lighthost-diagnostics.XXXXXX)"
trap 'rm -rf "$work"' EXIT INT TERM

release="$(cat /usr/share/lighthost/release 2>/dev/null || echo unknown)"
enabled="$(uci -q get lighthost.@lighthost[0].enabled || echo 0)"
data_dir="$(uci -q get lighthost.@lighthost[0].data_dir || true)"
ready=no
/usr/bin/lighthost-ready >/dev/null 2>&1 && ready=yes

cat > "$work/summary.txt" <<EOF
format=1
release=$release
enabled=$enabled
ready=$ready
kernel=$(uname -r)
architecture=$(uname -m)
data_dir_configured=$([ -n "$data_dir" ] && echo yes || echo no)
EOF

{
	for interface in br-lan lighthost-lan lh-lan-op lh-lan-d; do
		if [ -e "/sys/class/net/$interface" ]; then
			printf '%s present operstate=' "$interface"
			cat "/sys/class/net/$interface/operstate" 2>/dev/null || echo unknown
		else
			echo "$interface absent"
		fi
	done
} > "$work/network.txt"

if [ -x /usr/bin/incus ]; then
	/usr/bin/incus list --format csv -c ns4 > "$work/instances.csv" 2> "$work/incus-error.txt" || true
else
	echo 'Incus client absent' > "$work/incus-error.txt"
fi

df -h /mnt 2>/dev/null > "$work/storage.txt" || true
ps w 2>/dev/null | awk 'NR == 1 || /[l]ighthost (daemon|privileged-daemon)/ {print}' > "$work/processes.txt"
tar -C "$work" -czf "$output" .
echo "$output"
