config lighthost
	option enabled '0'
	option vm_workflow_enabled '0'
	option vm_pilot_enabled '0'
	option vm_pilot_policy_file '/etc/lighthost/vm-pilot/policy.json'
	option vm_pilot_public_key_file '/etc/lighthost/vm-pilot/release-signer.pub'
	option data_dir ''
	option http_socket '/var/run/lighthost/http.sock'
	option priv_socket '/var/run/lighthost/priv.sock'
	option storage_pool 'default'
	option auth_mode 'openwrt'
	option backup_repository ''
	option backup_repository_owner 'lighthost'
	option backup_repository_id '00000000-0000-7000-8000-000000000901'
	option backup_repository_disk_serial ''
	option backup_repository_uuid ''
	option docker_manager_socket '/var/run/dockermanager.sock'
	option docker_manager_token_file '/etc/lighthost/docker-manager.token'
	option node_id 'local'
